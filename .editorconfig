# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project
# More information at https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = crlf

[*.sh]
end_of_line = lf

[Dockerfile]
end_of_line = lf

[docker-compose.yml]
end_of_line = lf

[docker-compose.swarm.yml]
end_of_line = lf

[*.conf]
end_of_line = lf

[*.toml]
end_of_line = lf

[mongo-init/*.js]
end_of_line = lf

[.coveragerc]
end_of_line = lf

[requirements.txt]
end_of_line = lf